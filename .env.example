# FPC-SORVAX Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER commit API keys, credentials, tokens, or other secrets.

# AI Provider: "mock" (default) or "openai"
AI_PROVIDER=mock

# OpenAI API Key (required only when AI_PROVIDER=openai)
# NEVER commit this value to version control.
# OPENAI_API_KEY=

# OpenAI Model (optional, default: gpt-4.1-nano)
# OPENAI_MODEL=gpt-4.1-nano

# AI Fallback Configuration
# When OpenAI fails with a transient error, automatically use fallback provider
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDER=mock

# Server Port (optional, default: 3001)
# PORT=3001
